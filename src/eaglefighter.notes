C 0x99D9 ...el boton
L 0x99DD interrupcion_demo_azar
C 0x99DD cada 16 cuadros...
C 0x99E7 ...una palanca al azar (R / 16)
L 0x99F3 empieza_mira              El boton o la barra en el titulo: 0xE046 si se pulsa uno de los dos
C 0x99F3 la barra
C 0x99FC guardada
C 0x9A00 el boton
C 0x9A08 uno de los dos
L 0x9A0E boton_lee                 GTTRIG 1 (el boton del mando): (DE) = 1 y (HL) = 1 si se acaba de pulsar; suelto, (HL) = 0
