# Puntos de entrada que el trazado NO puede deducir solo.
#
# Cada uno lleva escrito POR QUE hace falta.

# El arranque: la cabecera esta en 0x8000 (0x4000-0x5FFF es 0xFF: la BIOS no encuentra "AB" en 0x4000 y mira
# 0x8000) y da INIT en 0x8010.
0x8010   # INIT

# La tabla de 0x742F (salto por A x 2, 0x7426): 17 rutinas.
0x7469
0x746A
0x74B5
0x74FC
0x7543
0x75AE
0x75BA
0x7601
0x7648
0x768F
0x76D6
0x771D
0x7751

